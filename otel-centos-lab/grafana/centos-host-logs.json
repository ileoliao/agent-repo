{
  "uid": "centos-host-logs",
  "title": "CentOS host \u00b7 Logs",
  "tags": [
    "centos",
    "otel",
    "centos-host"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "description": "Host agent from otel-centos-lab: system logs (journald) and application log files in Loki; host filters use labels on Mimir series.",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "type": "table",
      "title": "Host info",
      "id": 100,
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "expr": "max by (instance, deployment_environment_name, datacenter, team, business_line, role) (last_over_time(system_cpu_logical_count{job=\"$job\",instance=\"$host\"}[2m]))",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "indexByName": {
              "instance": 0,
              "deployment_environment_name": 1,
              "datacenter": 2,
              "team": 3,
              "business_line": 4,
              "role": 5
            },
            "renameByName": {
              "instance": "Host",
              "deployment_environment_name": "Environment",
              "datacenter": "Datacenter",
              "team": "Team",
              "business_line": "Business line",
              "role": "Role"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Log lines by level",
      "id": 17,
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "sum by (detected_level) (count_over_time({service_name=~\".+\"} | service_instance_id=\"$host\" | detected_level=~\"$level\" | systemd_unit=~\"$unit\" |~ \"$search\" [1m]))",
          "legendFormat": "{{detected_level}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never",
            "drawStyle": "bars"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "fatal"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "dark-red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "warn"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "info"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "unknown"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "gray"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "logs",
      "title": "Logs",
      "id": 18,
      "datasource": {
        "type": "loki",
        "uid": "${logs}"
      },
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 24,
        "h": 24
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "expr": "{service_name=~\".+\"} | service_instance_id=\"$host\" | detected_level=~\"$level\" | systemd_unit=~\"$unit\" |~ \"$search\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "metrics",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "logs",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      },
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${metrics}"
        },
        "query": {
          "query": "label_values(system_cpu_time, job)",
          "refId": "job"
        },
        "refresh": 2,
        "current": {}
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${metrics}"
        },
        "query": {
          "query": "label_values(system_cpu_logical_count{job=\"$job\"}, deployment_environment_name)",
          "refId": "env"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "datacenter",
        "label": "Datacenter",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${metrics}"
        },
        "query": {
          "query": "label_values(system_cpu_logical_count{job=\"$job\",deployment_environment_name=~\"$env\"}, datacenter)",
          "refId": "datacenter"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "team",
        "label": "Team",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${metrics}"
        },
        "query": {
          "query": "label_values(system_cpu_logical_count{job=\"$job\",deployment_environment_name=~\"$env\",datacenter=~\"$datacenter\"}, team)",
          "refId": "team"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "business_line",
        "label": "Business line",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${metrics}"
        },
        "query": {
          "query": "label_values(system_cpu_logical_count{job=\"$job\",deployment_environment_name=~\"$env\",datacenter=~\"$datacenter\",team=~\"$team\"}, business_line)",
          "refId": "business_line"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "role",
        "label": "Role",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${metrics}"
        },
        "query": {
          "query": "label_values(system_cpu_logical_count{job=\"$job\",deployment_environment_name=~\"$env\",datacenter=~\"$datacenter\",team=~\"$team\",business_line=~\"$business_line\"}, role)",
          "refId": "role"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${metrics}"
        },
        "query": {
          "query": "label_values(system_cpu_logical_count{job=\"$job\",deployment_environment_name=~\"$env\",datacenter=~\"$datacenter\",team=~\"$team\",business_line=~\"$business_line\",role=~\"$role\"}, instance)",
          "refId": "host"
        },
        "refresh": 2,
        "current": {},
        "sort": 1
      },
      {
        "name": "level",
        "label": "Level",
        "type": "custom",
        "query": ".*,fatal|error,warn,info,unknown",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "options": []
      },
      {
        "name": "unit",
        "label": "systemd unit (regex)",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      },
      {
        "name": "search",
        "label": "Search (regex)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "links": [
    {
      "title": "CentOS host",
      "type": "dashboards",
      "tags": [
        "centos-host"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false
    }
  ]
}
