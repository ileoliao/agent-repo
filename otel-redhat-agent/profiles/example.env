# Template: copy and name it as you like, e.g. one profile per environment, machine role and region
# (prod-db-hk.env, or with a prefix such as payments-prod-db-hk.env). KEY=VALUE per line, no quotes
# needed, no token (OTEL_TOKEN is refused in a profile).
COLLECTOR_ENDPOINT=https://otel-gw.hk.corp.example:4318
REPO_URL=https://repo.corp.example/otel/el9/
OTEL_VERSION=0.164.0
HOST_ATTRIBUTES=deployment.environment.name=prod,team=infra,business_line=payments,role=db,region=hk
# Per-process metrics: regex on the executable name (unanchored; use ^...$ for exact names, .* = every process).
# Legacy PROCESS_NAMES=sshd mysqld still works and is converted to ^(sshd|mysqld)$.
PROCESS_ALLOW_REGEX=^(sshd|chronyd|mysqld)$
SYSTEM_LOGS=true
LOG_PATHS=/var/log/mysql/*.log
# Optional resource ceiling (defaults 50% / 300M); raise for log-heavy hosts
# AGENT_CPU_QUOTA=50%
# AGENT_MEMORY_MAX=300M
