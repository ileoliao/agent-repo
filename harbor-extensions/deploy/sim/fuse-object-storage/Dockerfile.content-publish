# Sim content-publish: FastAPI + rclone → s3://harbor-content (SeaweedFS / minio-fuse).
# Build context: harbor-extensions/ (repo root).
#   docker build -t harbor-content-publish:sim -f deploy/sim/fuse-object-storage/Dockerfile.content-publish .
FROM harbor-fuse-rclone:sim AS rclone

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1
COPY --from=rclone /usr/local/bin/rclone /usr/local/bin/rclone
RUN pip install --no-cache-dir "fastapi>=0.115" "uvicorn>=0.30" \
    && useradd --uid 10003 --create-home --shell /usr/sbin/nologin content \
    && mkdir -p /app /tmp/content-publish \
    && chown -R content:content /app /tmp/content-publish
WORKDIR /app
COPY backend/content_publish ./content_publish
USER 10003
EXPOSE 8080
CMD ["python", "-m", "uvicorn", "content_publish.app:app", "--host", "0.0.0.0", "--port", "8080", "--log-level", "warning"]
