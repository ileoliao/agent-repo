{
  "baseUrl": "",
  "timeoutSec": 20,
  "auth": { "header": "Authorization", "scheme": "Bearer", "env": "HARBOR_PAT" },
  "timeseries": {
    "path": "/api/v1/metrics/query",
    "params": { "signal": "{signal}", "from": "{from}", "to": "{to}", "step": "{step}" },
    "points": "data.points",
    "time": "t",
    "value": "v",
    "timeFormat": "epoch_s"
  },
  "breakdown": {
    "path": "/api/v1/traffic/top",
    "params": { "signal": "{signal}", "from": "{from}", "to": "{to}", "by": "{by}", "limit": "{limit}" },
    "items": "data.items"
  },
  "stepSeconds": 60,
  "minBaselineDays": 3,
  "signals": [
    { "name": "request_rate", "unit": "req/min", "baselineDays": 7, "high": 2.0, "low": 0.4, "minBaseline": 30 },
    { "name": "error_rate", "unit": "ratio", "baselineDays": 7, "high": 3.0, "minBaseline": 0.001, "absoluteHigh": 0.05 }
  ]
}
